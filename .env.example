# ============================================================
# LIVIA BOT — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Pasta de dados (SQLite + sessão do WhatsApp)
DATA_DIR=./data

# Porta do servidor (o Render define automaticamente em produção)
PORT=3200
NODE_ENV=development

# JWT — troque por algo longo e aleatório
JWT_SECRET=troque-esta-chave-por-algo-secreto-e-longo

# Groq API (gratuita) — para análise de histórico e geração de FAQ
# Crie sua chave em: https://console.groq.com
GROQ_API_KEY=

# Configurações do negócio (também editáveis pelo painel)
BUSINESS_NAME=Negócio da Livia
OWNER_PHONE=5511999999999

# Horário de atendimento (24h, fuso America/Sao_Paulo)
WORKING_HOURS_START=9
WORKING_HOURS_END=18
TZ=America/Sao_Paulo

# Senha inicial do painel (será alterável pelo painel)
ADMIN_PASSWORD=livia123

# Chave de recuperação — usada na tela de login ("Esqueci minha senha")
# para redefinir a senha do painel sem precisar da senha atual.
# Escolha uma frase longa só sua e guarde em local seguro (ex: gerenciador de senhas).
RECOVERY_KEY=
